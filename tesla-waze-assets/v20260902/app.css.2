/* ===== Resizable / minimizable Smart Music ===== */
.music-modal{pointer-events:none;align-items:flex-end!important;justify-content:flex-end!important;padding:10px;background:transparent!important}
.music-shell{position:relative;pointer-events:auto;max-width:calc(100vw - 20px);max-height:calc(100vh - 20px);min-width:340px;min-height:154px;border-radius:14px;overflow:hidden;box-shadow:-8px 8px 34px rgba(0,0,0,.34)!important}
.music-shell.music-minimized .music-body{display:none!important}
.music-shell.music-minimized .music-head{padding:8px 10px}
.music-shell.music-minimized .music-head h2{font-size:15px}.music-shell.music-minimized .music-head small{font-size:9px}
.music-shell.music-minimized .music-player{flex:1;overflow:hidden;border-top:1px solid #29404f;padding:7px 10px}
.music-shell.music-minimized .music-player .yt-player,.music-shell.music-minimized .music-player audio{display:none!important}
.music-shell.music-minimized .music-now{margin-bottom:5px}.music-shell.music-minimized .music-art{width:36px;height:36px}.music-shell.music-minimized .music-title{font-size:12px}.music-shell.music-minimized .music-controls{display:grid;grid-template-columns:repeat(6,1fr);gap:4px}.music-shell.music-minimized .music-controls .btn{padding:5px 4px;font-size:11px}
.music-min-btn{white-space:nowrap}
.music-resize{position:absolute;z-index:20;touch-action:none;background:transparent}.music-resize-left{left:-5px;top:18px;bottom:18px;width:12px;cursor:ew-resize}.music-resize-top{top:-5px;left:18px;right:18px;height:12px;cursor:ns-resize}
.music-resize-left:after{content:'';position:absolute;left:5px;top:40%;height:20%;width:2px;border-radius:2px;background:rgba(120,160,180,.55)}.music-resize-top:after{content:'';position:absolute;top:5px;left:40%;width:20%;height:2px;border-radius:2px;background:rgba(120,160,180,.55)}
@media(max-width:650px){.music-modal{padding:4px}.music-shell{max-width:calc(100vw - 8px);max-height:calc(100vh - 8px);min-width:300px}.music-min-btn{font-size:11px;padding:7px}}

.music-fab{position:fixed;right:22px;bottom:22px;z-index:5600;width:58px;height:58px;border-radius:16px;border:1px solid rgba(148,163,184,.38);background:rgba(15,23,32,.58);backdrop-filter:blur(12px);color:#fff;font-size:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.22);opacity:.72;transition:.18s}.music-fab:hover,.music-fab:focus{opacity:.98;transform:translateY(-1px)}.music-modal:not(.hidden)~.music-fab{opacity:.45}@media(max-width:760px){.music-fab{right:14px;bottom:14px;width:52px;height:52px;font-size:24px}}