.music-track{grid-template-columns:56px minmax(0,1fr) 104px;overflow:hidden;cursor:pointer}
.music-track>.btn{width:104px;max-width:104px;min-width:0;padding:0 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.music-track>div{min-width:0}
