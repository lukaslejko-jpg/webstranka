*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;font-family:Inter,system-ui,sans-serif;background:#0b1118;color:#f8fafc}button,input{font:inherit}button{cursor:pointer}.hidden{display:none!important}.app{height:100dvh;display:grid;grid-template-columns:390px 1fr;overflow:hidden}.app.panel-off{grid-template-columns:1fr}.app.navcompact{grid-template-columns:350px 1fr}.panel{background:#101820;border-right:1px solid #263442;padding:14px;overflow-y:auto;overscroll-behavior:contain;z-index:20}.panel.navcompact{width:350px;padding:10px}.panel header{position:sticky;top:-14px;z-index:30;background:#101820;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0 10px}.panel h1{font-size:26px;margin:2px 0 0}.sub{font-size:11px;color:#7dd3fc;font-weight:900;text-transform:uppercase;letter-spacing:.11em}.btn{min-height:46px;border-radius:12px;border:1px solid #334556;background:#1b2a35;color:#f8fafc;font-weight:800;padding:0 12px}.btn.primary{background:#16b8b4;border-color:#16b8b4;color:#031b1b}.btn.danger{background:#3a1b20;border-color:#7f1d1d}.btn:disabled{opacity:.45}.wide{width:100%;margin:6px 0}.quickbar{display:grid;grid-template-columns:1.25fr .8fr .8fr;gap:8px;margin:8px 0 4px}.quickbar .btn{min-height:40px;font-size:14px}.card,.fold,.searchbox{background:#16212b;border:1px solid #2b3a47;border-radius:14px;padding:11px;margin-top:10px}.row{display:flex;gap:8px}.row input{width:100%;min-height:52px;border-radius:12px;border:1px solid #334556;background:#0f1720;color:#fff;padding:0 13px}.results{display:grid;gap:6px;margin-top:8px}.result{width:100%;min-height:58px;text-align:left;border-radius:11px;border:1px solid #334556;background:#1b2a35;color:#fff;padding:9px 12px;margin:4px 0}.result b,.result small{display:block}.card small,.fold small,.result small{color:#a8bac7}.fold{padding:0}.fold summary{min-height:58px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 14px;cursor:pointer;list-style:none}.fold summary::-webkit-details-marker{display:none}.foldtitle{display:flex;min-width:0;flex-direction:column;gap:2px}.foldtitle small{font-size:11px;color:#8fa8b8;font-weight:700}.foldchev{display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:9px;background:#0f1720;border:1px solid #334556;color:#22d3ee;font-size:22px;font-weight:900;transition:.18s}.fold[open] .foldchev{transform:rotate(90deg);background:#17323b}.foldbody{padding:0 11px 11px}.fold label{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 0}.fold input[type=checkbox]{width:23px;height:23px}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.chip{min-height:38px;border:1px solid #334556;background:#1b2a35;color:#fff;border-radius:10px;padding:0 9px;font-weight:800}.chip.active{outline:2px solid #22d3ee}.mapwrap{position:relative;min-width:0;height:100dvh}.map{height:100%;width:100%;background:#111827}.topbar{position:absolute;top:14px;right:14px;z-index:1100;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.badge{background:rgba(15,23,32,.93);border:1px solid #314151;border-radius:12px;padding:9px 12px;font-weight:800}.routebox{position:absolute;left:14px;top:76px;z-index:1000;max-width:430px;background:rgba(15,23,32,.95);border:1px solid #314151;border-radius:14px;padding:12px;box-shadow:0 8px 28px #0006}.routeStats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:8px}.routeStats div{background:#16212b;border-radius:9px;padding:7px;text-align:center}.routeStats b,.routeStats small{display:block}.routeStats small{font-size:10px;color:#a8bac7}.alertbox{position:absolute;left:14px;bottom:18px;z-index:1100;max-width:440px;background:rgba(69,10,10,.95);border:1px solid #ef4444;border-radius:14px;padding:12px 14px;font-size:18px;font-weight:900}.gpsnotice{margin-top:8px;border:1px solid #3b4b59;background:#121c25;border-radius:12px;padding:9px 11px;font-size:12px;color:#a8bac7;display:flex;gap:8px}.car-arrow{width:38px;height:38px;border-radius:50%;background:#16b8b4;border:3px solid #fff;color:#042f2e;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;box-shadow:0 3px 12px #0008}.car-wrap{background:transparent!important;border:none!important}.alert-pin,.charge-pin{display:flex!important;align-items:center;justify-content:center;border-radius:50%;border:2px solid #fff;box-shadow:0 2px 10px #0008}.alert-pin{background:#dc2626}.charge-pin{background:#0ea5e9;font-weight:900}.charge-pin small{font-size:8px}.modal{position:fixed;inset:0;background:#000b;z-index:5000;padding:20px;display:flex;align-items:center;justify-content:center}.modalbox{width:min(560px,100%);background:#111b24;border:1px solid #334556;border-radius:18px;padding:20px;text-align:center}.modalbox img{max-width:280px;width:100%;background:#fff;padding:8px;border-radius:12px}.code{font:900 44px ui-monospace,monospace;letter-spacing:.16em;color:#22d3ee}.leaflet-top.leaflet-left{left:auto!important;right:14px!important;top:76px!important}.music-modal{position:fixed;inset:0;z-index:6000;background:transparent;display:flex;justify-content:flex-end;pointer-events:none}.music-shell{pointer-events:auto}.music-shell{width:min(660px,100vw);height:100%;background:#0f1720;border-left:1px solid #334155;display:flex;flex-direction:column}.music-head{display:flex;gap:12px;align-items:center;paddin