{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/youtube-search",
      "destination": "https://tesla-waze-piped-i9nw8dg6c-lukaslejko-9932s-projects.vercel.app/api/youtube-search"
    },
    {
      "source": "/api/apple-touch-icon",
      "destination": "/icons/music-v39-180.png"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/icons/music-v39-180.png"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/desktop/",
      "destination": "/desktop",
      "permanent": false
    }
  ]
}
